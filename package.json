{
  "name": "f1-manager-multiplayer",
  "version": "1.4.4",
  "private": true,
  "description": "F1 Manager Multiplayer - Gestão de equipe de Fórmula 1 com backend e persistência em banco",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@f1m/server",
    "dev:client": "npm run dev --workspace=@f1m/client",
    "build:core": "npm run build --workspace=@f1m/core",
    "build": "npm run build --workspace=@f1m/core && npm run build --workspace=@f1m/client && npm run build --workspace=@f1m/server",
    "start": "npm run start --workspace=@f1m/server",
    "db:push": "npm run db:push --workspace=@f1m/server"
  },
  "keywords": [
    "f1",
    "manager",
    "multiplayer",
    "fastify",
    "react",
    "vite"
  ],
  "author": "theuz013",
  "license": "MIT",
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true
  }
}
